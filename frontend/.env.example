# Frontend environment variables (see README.md for details).
#
# Origin of the Flask API, e.g. http://localhost:5000 in development.
# In production the frontend and API are served behind one reverse proxy,
# so this can be left empty to use the same origin.
NEXT_PUBLIC_API_URL=

# Cookie names the backend uses for user/admin sessions.
# The middleware only checks presence; real auth is verified via API.
NEXT_PUBLIC_USER_SESSION_COOKIE=nourai_user_session
NEXT_PUBLIC_ADMIN_SESSION_COOKIE=nourai_admin_session
