# ─── Nourai («نورا») environment template ─────────────────────────────
# Copy to .env and fill real values. NEVER commit .env.

# App
APP_ENV=development            # development | staging | production
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=                 # e.g. .nourai.ir in production; empty for localhost
NEXT_PUBLIC_API_URL=           # e.g. https://api.nourai.ir ; empty = same origin (/api/v1)

# Database / cache
DATABASE_URL=mysql+pymysql://nourai:nourai@localhost:3306/nourai?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Object storage (S3-compatible; MinIO in development)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=nourai
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false

# SMS — provider is sms.ir in production (SMS_PROVIDER=smsir).
# Endpoints/fields must match the official SMS.ir docs for your account version;
# SMSIR_API_BASE_URL is combined with paths inside the adapter — see providers/sms_ir.py.
SMS_PROVIDER=fake               # fake | smsir   (fake is dev/test ONLY, refused in production)
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=              # approved OTP template/pattern id of your SMS.ir account
SMSIR_API_BASE_URL=             # base URL from official SMS.ir docs, e.g. https://api.sms.ir/...

# Payments — gateway is Zibal in production (PAYMENT_PROVIDER=zibal).
# Endpoint paths, amount unit and response codes must match the official Zibal docs
# for the API version you use; see providers/zibal.py (no endpoints are guessed).
PAYMENT_PROVIDER=fake           # fake | zibal   (fake is dev/test ONLY, refused in production)
ZIBAL_MERCHANT=
ZIBAL_API_BASE_URL=             # base URL from official Zibal docs
ZIBAL_CALLBACK_URL=             # public HTTPS callback, e.g. https://nourai.ir/api/v1/payments/callback/zibal

# AI providers (intermediary providers supplied later by the project owner)
AI_TEXT_PROVIDER=fake
AI_AUDIO_PROVIDER=fake
AI_IMAGE_PROVIDER=fake
AI_PROVIDER_API_KEY=

# Image pipeline hard ceilings (admin settings can never exceed these)
IMAGE_UPLOAD_HARD_MAX_BYTES=10485760        # 10 MiB
IMAGE_INPUT_HARD_MAX_PIXELS=16777216        # 4096x4096
IMAGE_INPUT_HARD_MAX_WIDTH=4096
IMAGE_INPUT_HARD_MAX_HEIGHT=4096
IMAGE_PROCESSING_TIMEOUT_SECONDS=60

# tiktoken encoding cache (local dir, avoids re-download)
TIKTOKEN_CACHE_DIR=/tmp/tiktoken_cache

# Audio limits
AUDIO_UPLOAD_HARD_MAX_BYTES=26214400       # 25 MiB

# Admin bootstrap (used ONLY by `flask create-admin`; password never hardcoded)
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Retention (days). Auto-deletion is NOT enabled until product policy is defined.
CONTENT_RETENTION_DAYS=365

# Compose convenience
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=nourai
MYSQL_USER=nourai
MYSQL_PASSWORD=nourai
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
FRONTEND_PORT=3000
NGINX_PORT=8080
